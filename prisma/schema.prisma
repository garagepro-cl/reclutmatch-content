generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  tagline       String         @default("")
  description   String         @default("")
  website       String         @default("")
  instagram     String         @default("")
  facebook      String         @default("")
  phone         String         @default("")
  ctaText       String         @default("")
  brandJson     String         @default("{}")
  topicsJson    String         @default("[]")
  platformsJson String         @default("[\"instagram\",\"facebook\",\"youtube\"]")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pieces        ContentPiece[]
  ideas         IdeaPropia[]
}

/// Ideas que anota una persona para que el sistema las use cuando le toque publicar.
/// La cola se consume por orden de llegada: la más antigua sin usar es la que sale primero.
/// Cuando no queda ninguna, el sistema vuelve a inventar el tema solo, como antes.
model IdeaPropia {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  texto      String
  usada      Boolean   @default(false)
  usadaAt    DateTime?
  /// Título de la pieza que salió de esta idea, para poder mirar en qué se convirtió
  resultado  String    @default("")
  createdAt  DateTime  @default(now())

  @@index([businessId, usada, createdAt])
}

model ContentPiece {
  id                String          @id @default(cuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type              String // CAROUSEL | VIDEO
  status            String          @default("DRAFT") // DRAFT | RENDERING | PENDING | APPROVED | PUBLISHED | REJECTED | FAILED
  pillar            String          @default("")
  customPrompt      String          @default("")
  title             String
  hook              String          @default("")
  slidesJson        String          @default("[]")
  caption           String          @default("")
  hashtags          String          @default("")
  source            String          @default("bank") // bank | ai
  outputDir         String          @default("")
  coverPath         String          @default("")
  videoPath         String          @default("")
  slideCount        Int             @default(0)
  telegramMessageId String          @default("")
  error             String          @default("")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  approvedAt        DateTime?
  publishedAt       DateTime?
  /// Ventana de veto: hora a la que la pieza se publica sola si nadie la frena.
  /// Null = no tiene publicación automática (o alguien apretó "Esperar").
  autoPublishAt     DateTime?
  /// Cuándo se frenó la publicación automática, para saber que fue decisión de alguien.
  vetoedAt          DateTime?
  targets           PublishTarget[]
}

model PublishTarget {
  id         String       @id @default(cuid())
  pieceId    String
  piece      ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  platform   String // instagram | facebook | youtube
  status     String       @default("PENDING") // PENDING | PUBLISHED | MANUAL_REQUIRED | FAILED
  externalId String       @default("")
  permalink  String       @default("")
  error      String       @default("")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Setting {
  key   String @id
  value String
}
